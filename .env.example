# Persistent SQLite database path. Docker defaults to /data/chrono_hybrid_mem.db.
MEMORY_DB_PATH=data/chrono_hybrid_mem.db
# Set to true for competition deployment. A private OPENAI_API_KEY is then required.
MEMORY_REQUIRE_MODEL=false
MEMORY_TEMPORAL_BONUS=0
# Reuses the existing gpt-4o-mini planner call; no extra model call.
MEMORY_STRUCTURED_QUERY_PLAN=false
# OPENAI_API_KEY=replace-through-your-secret-manager
# Optional v0.3 local method-development backend; leave blank for the v0.2 competition image.
# Validated full-set configuration (model files are downloaded at runtime and never committed):
# MEMORY_LOCAL_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
# MEMORY_LOCAL_EMBEDDING_DEVICE=cpu
# MEMORY_LOCAL_EMBEDDING_BATCH_SIZE=64
# MEMORY_LOCAL_MODEL_CACHE=.model-cache
MEMORY_DENSE_RRF_WEIGHT=1
# Set to 0..1 to replace RRF with z-score BM25/dense score fusion.
# MEMORY_DENSE_FUSION_ALPHA=0.3
# Optional previous+current-message dense key blend; 0 keeps raw-turn embeddings.
# MEMORY_DENSE_CONTEXT_WEIGHT=0.5
# Optional timestamp-prefixed dense key blend; 0 keeps raw-turn embeddings.
# MEMORY_DENSE_TIME_WEIGHT=0.5
# MEMORY_LOCAL_RERANK_MODEL=answerdotai/answerai-colbert-small-v1
# Alternative mutually exclusive joint query-passage reranker.
# MEMORY_LOCAL_CROSS_ENCODER_MODEL=BAAI/bge-reranker-base
# MEMORY_LOCAL_RERANK_TOP_N=5
# MEMORY_LOCAL_RERANK_BATCH_SIZE=32
# Optional 0..1 z-score blend with the first-stage score; blank keeps hard reranking.
# MEMORY_LOCAL_RERANK_FUSION_WEIGHT=0.3
# Optional purpose-trained yes/no reranker. This is local development only and
# requires a loopback llama.cpp server with a compatible Qwen3-Reranker model.
# It cannot be combined with either FastEmbed local reranker setting above.
# MEMORY_LOCAL_YES_NO_RERANK_BASE_URL=http://127.0.0.1:8081/v1
# MEMORY_LOCAL_YES_NO_RERANK_MODEL=local
# MEMORY_LOCAL_YES_NO_RERANK_TIMEOUT=120
# Experimental hierarchical session-to-turn signal; 0 keeps flat turn ranking.
MEMORY_SESSION_FUSION_WEIGHT=0
# Optional hard first-stage session filter; 0 keeps all sessions.
MEMORY_SESSION_TOP_N=0
# Optional loopback-only local instruction model for constrained candidate-ID ordering.
# MEMORY_LOCAL_INSTRUCTION_BASE_URL=http://127.0.0.1:8081/v1
# MEMORY_LOCAL_INSTRUCTION_MODEL=local
# MEMORY_LOCAL_INSTRUCTION_TOP_N=10
# Optional second pass over the first pass's leading candidates; 0 disables it.
# MEMORY_LOCAL_INSTRUCTION_REFINE_TOP_N=3
# MEMORY_LOCAL_INSTRUCTION_TIMEOUT=120
# MEMORY_LOCAL_INSTRUCTION_THINKING=false
# MEMORY_LOCAL_INSTRUCTION_STRATEGY=chain_of_note
# Optional loopback query rewriting for max-over-rewrites dense retrieval.
# MEMORY_LOCAL_QUERY_EXPANSION_BASE_URL=http://127.0.0.1:8081/v1
# MEMORY_LOCAL_QUERY_EXPANSION_MODEL=local
# MEMORY_LOCAL_QUERY_EXPANSION_TIMEOUT=120
