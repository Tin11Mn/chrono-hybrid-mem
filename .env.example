# Persistent SQLite database path. Docker defaults to /data/chrono_hybrid_mem.db.
MEMORY_DB_PATH=data/chrono_hybrid_mem.db
# Set to true for competition deployment. A private OPENAI_API_KEY is then required.
MEMORY_REQUIRE_MODEL=false
MEMORY_TEMPORAL_BONUS=0
# OPENAI_API_KEY=replace-through-your-secret-manager
# Optional v0.3 local method-development backend; leave blank for the v0.2 competition image.
# Validated full-set configuration (model files are downloaded at runtime and never committed):
# MEMORY_LOCAL_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
# MEMORY_LOCAL_EMBEDDING_DEVICE=cpu
# MEMORY_LOCAL_EMBEDDING_BATCH_SIZE=64
# MEMORY_LOCAL_MODEL_CACHE=.model-cache
MEMORY_DENSE_RRF_WEIGHT=1
# Set to 0..1 to replace RRF with z-score BM25/dense score fusion.
# MEMORY_DENSE_FUSION_ALPHA=0.3
# MEMORY_LOCAL_RERANK_MODEL=answerdotai/answerai-colbert-small-v1
# MEMORY_LOCAL_RERANK_TOP_N=5
# MEMORY_LOCAL_RERANK_BATCH_SIZE=32
